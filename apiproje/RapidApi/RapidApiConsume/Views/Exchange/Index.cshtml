@model List<RapidApiConsume.Models.Exchange_Rates>
@{
    ViewData["Title"] = "Currency Exchange Rates";
}

<div class="text-center">
    <h1 class="display-4">Currency Exchange Rates</h1>
    <p>Real-time USD to TRY exchange rates</p>
</div>

<div class="container">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <table class="table table-striped table-bordered">
                <thead class="thead-dark">
                    <tr>
                        <th>Currency Name</th>
                        <th>Buy Rate</th>
                        <th>Sell Rate</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.currency_name</td>
                                <td>@item.exchange_rate_buy</td>
                                <td>@item.exchange_rate_sell</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="3" class="text-center">No exchange rate data available</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>